# ANTREYUK CONFIGURATION
# Dapatkan kredensial berikut dari Supabase Dashboard: Settings -> API

# URL Project Supabase (contoh: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (Aman digunakan di browser frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ID Toko (Gunakan UUID default jika sistem single-store)
VITE_STORE_ID=00000000-0000-0000-0000-000000000001

